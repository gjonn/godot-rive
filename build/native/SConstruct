#!/usr/bin/env python
env = SConscript('../../godot-cpp/SConstruct', {'api_version': '4.7'})
if env['platform'] != 'macos':
    print('The CoreGraphics backend currently targets macOS. Other backends are not bundled.')
    Exit(1)
if env['arch'] != 'arm64':
    print('Build the Rive static libraries for the requested architecture first; this build targets arm64.')
    Exit(1)

env.Append(CPPPATH=['../../native', '../../thirdparty/rive-cpp/include',
                   '../../thirdparty/rive-cpp/cg_renderer/include'])
env.Append(CPPDEFINES=['WITH_RIVE_TEXT', 'WITH_RIVE_LAYOUT'])
env.Append(CXXFLAGS=['-std=c++17'])
env.Append(LIBPATH=['out/release'])
env.Append(LIBS=['rive_cg_renderer', 'rive', 'rive_harfbuzz', 'rive_sheenbidi', 'rive_yoga'])
env.Append(LINKFLAGS=['-framework', 'CoreGraphics', '-framework', 'CoreFoundation',
                      '-framework', 'CoreText', '-framework', 'ImageIO'])
library = env.SharedLibrary('bin/librive_surface.macos.' + env['target'] + '.arm64.dylib',
                           source=Glob('../../native/*.cpp'))
Default(library)
