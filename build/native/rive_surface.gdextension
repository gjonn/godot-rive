[configuration]
entry_symbol = "rive_surface_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
macos.debug.arm64 = "bin/librive_surface.macos.template_debug.arm64.dylib"
macos.release.arm64 = "bin/librive_surface.macos.template_release.arm64.dylib"
ios.debug = "bin/librive_surface.ios.template_debug.xcframework"
ios.release = "bin/librive_surface.ios.template_release.xcframework"
windows.debug.x86_64 = "bin/librive_surface.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "bin/librive_surface.windows.template_release.x86_64.dll"
